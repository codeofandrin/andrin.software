{
  "name": "aps-digital.ch",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "rm -r .next | next dev --webpack",
    "build": "rm -r .next | next build --webpack",
    "start": "next start",
    "format": "prettier --write --list-different .",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters --composite false",
    "check": "npm run format && npm run typecheck && npm run knip",
    "bump": "npm version -m 'Bump version to %s' $npm_config_vers",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@paper-design/shaders-react": "^0.0.82",
    "@react-email/components": "1.0.10",
    "@react-email/render": "2.0.4",
    "@svgr/webpack": "^8.1.0",
    "@vercel/firewall": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "next": "^16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "raw-loader": "^4.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "resend": "^6.9.3",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "knip": "^6.43.0",
    "react-email": "5.2.10",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
